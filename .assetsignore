# Files and folders listed here are NOT uploaded when this site is deployed
# to Cloudflare. They're planning/reference material in the GitHub repo, not
# part of the actual live app (which is just index.html + the app/ folder).
# Keeping these out makes deploys faster and keeps the live site limited to
# only the files it actually needs.

.git
.github
node_modules
wrangler.jsonc
.assetsignore

